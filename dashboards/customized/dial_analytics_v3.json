          "query": "SELECT\n  date_bin(INTERVAL '$__interval', time, TIMESTAMP '1970-01-01T00:00:00Z') AS _time,\n  COUNT(*) AS _value\nFROM analytics\nWHERE time >= $__timeFrom AND time < $__timeTo\n  AND _measurement = 'analytics'\n  AND _field = 'number_request_messages'\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
